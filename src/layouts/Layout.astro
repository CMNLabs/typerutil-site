---
import '../styles/global.css';
import { BUY_URL, DOWNLOAD_URL, EU_COUNTRIES, PRICES, REPORT_BUG_PAGE } from '../consts';

interface Props {
  title?: string;
  description?: string;
  /** Keeps the page out of search results, for pages only reached from elsewhere (like checkout). */
  noindex?: boolean;
}

const {
  title,
  description = 'A macOS menubar utility that types text for you, for forms that block paste or mangle pasted input.',
  noindex = false,
} = Astro.props;
const fullTitle = title ? `${title} · Typer Util` : 'Typer Util · Type text where paste won’t work';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/icon-256.png', Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="flex min-h-screen flex-col bg-white font-sans text-zinc-800 antialiased dark:bg-zinc-950 dark:text-zinc-200">
    <header class="mx-auto flex w-full max-w-5xl items-center justify-between px-4 py-5 sm:px-6">
      <a href="/" class="flex items-center gap-2.5 font-semibold text-zinc-900 dark:text-white">
        <img src="/favicon.svg" alt="" width="32" height="32" class="size-8" />
        Typer Util
      </a>
      <nav class="flex items-center gap-1 text-sm sm:gap-2">
        <a href="/changelog" class="rounded-md px-2.5 py-1.5 text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white">Changelog</a>
        <a href={BUY_URL} data-price="Buy ({price})" class="rounded-md px-3 py-1.5 font-medium text-brand-600 ring-1 ring-brand-500/40 ring-inset hover:bg-brand-500/10 dark:text-brand-300">Buy</a>
        <a href={DOWNLOAD_URL} class="rounded-md bg-brand-500 px-3 py-1.5 font-medium text-white hover:bg-brand-600">Download</a>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-zinc-200 dark:border-zinc-800">
      <div class="mx-auto flex max-w-5xl flex-col gap-3 px-4 py-8 text-sm text-zinc-500 sm:flex-row sm:items-center sm:justify-between sm:px-6">
        <p>© {new Date().getFullYear()} CMNLabs</p>
        <div class="flex gap-5">
          <a href="/changelog" class="hover:text-zinc-900 dark:hover:text-white">Changelog</a>
          <a href={REPORT_BUG_PAGE} class="hover:text-zinc-900 dark:hover:text-white">Report a bug</a>
        </div>
      </div>
    </footer>
    <!--
      Fills in the local price wherever an element has data-price, a template like "Buy ({price})". Runs
      inline at the end of the body, so a country remembered from an earlier visit is applied before the
      first paint. Then it always asks Cloudflare's /cdn-cgi/trace (answered by Cloudflare's proxy, so not
      on the dev server) where the visitor is now.
    -->
    <script is:inline define:vars={{ prices: PRICES, euCountries: EU_COUNTRIES }}>
      (() => {
        const storageKey = 'buy-country';
        const show = (country) => {
          const price = country === 'GB' ? prices.uk : euCountries.includes(country) ? prices.eu : prices.other;
          for (const el of document.querySelectorAll('[data-price]')) {
            el.textContent = el.dataset.price.replace('{price}', price);
          }
        };

        try {
          const cached = localStorage.getItem(storageKey);
          if (cached) show(cached);
        } catch {}

        fetch('/cdn-cgi/trace')
          .then((response) => (response.ok ? response.text() : Promise.reject()))
          .then((text) => {
            const country = text.match(/^loc=([A-Z]{2})$/m)?.[1];
            if (!country) return;
            show(country);
            try {
              localStorage.setItem(storageKey, country);
            } catch {}
          })
          .catch(() => {});
      })();
    </script>
  </body>
</html>
