---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found">
  <div class="mx-auto max-w-xl px-4 py-24 text-center sm:px-6">
    <p class="font-mono text-sm text-brand-500">404</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-zinc-900 dark:text-white">Page not found</h1>
    <p class="mt-4 text-zinc-600 dark:text-zinc-400">That page doesn’t exist, or it has moved.</p>
    <a href="/" class="mt-8 inline-block rounded-lg bg-brand-500 px-4 py-2 font-medium text-white hover:bg-brand-600">Back home</a>
  </div>
</Layout>
