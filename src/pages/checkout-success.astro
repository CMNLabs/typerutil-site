---
import Layout from '../layouts/Layout.astro';
import { REPORT_BUG_PAGE } from '../consts';
---

<!--
  Polar sends buyers here after checkout, with ?checkout_id=…&customer_session_token=…. The token lets the
  page read the buyer's license key from Polar's customer portal API, which allows browser requests. Without
  it (or if the request fails) the page still thanks them and says where to find the key.
-->
<Layout title="Thank you" noindex>
  <div class="mx-auto max-w-xl px-4 py-20 text-center sm:px-6 sm:py-24">
    <div class="mx-auto flex size-16 items-center justify-center rounded-full bg-brand-500/10 text-brand-500 ring-8 ring-brand-500/5">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="size-8" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
    </div>
    <h1 class="mt-6 text-4xl font-bold tracking-tight text-balance text-zinc-900 dark:text-white">Thank you!</h1>
    <p class="mt-4 text-lg text-pretty text-zinc-600 dark:text-zinc-400">
      Your Typer Util license is yours to keep. Thanks for supporting a small app.
    </p>

    <div class="mt-10 rounded-2xl border border-zinc-200 bg-zinc-50 p-6 text-left dark:border-zinc-800 dark:bg-zinc-900/60">
      <h2 class="text-sm font-semibold text-zinc-900 dark:text-white">Your license key</h2>

      <!-- One of these is shown by the script below. -->
      <p data-state="loading" class="mt-3 text-sm text-zinc-500" hidden>Fetching your key…</p>
      <div data-state="key" class="mt-3 flex items-center gap-2" hidden>
        <code data-key class="min-w-0 flex-1 rounded-lg break-all border border-zinc-200 bg-white px-3 py-2 font-mono text-sm text-zinc-800 dark:border-zinc-700 dark:bg-zinc-950 dark:text-zinc-200"></code>
        <button type="button" data-copy class="shrink-0 rounded-lg bg-brand-500 px-3 py-2 text-sm font-medium text-white hover:bg-brand-600">Copy</button>
      </div>
      <p data-state="fallback" class="mt-3 text-sm text-zinc-600 dark:text-zinc-400">
        Polar has emailed you a receipt. Your license key is in your Polar customer portal, linked from that email.
      </p>

      <ol class="mt-6 space-y-2 text-sm text-zinc-600 dark:text-zinc-400">
        <li>1. Open Typer Util’s preferences: choose <strong class="font-medium text-zinc-800 dark:text-zinc-200">Preferences…</strong> from its menubar icon.</li>
        <li>2. Go to <strong class="font-medium text-zinc-800 dark:text-zinc-200">License</strong> and paste your key.</li>
      </ol>
    </div>

    <p class="mt-8 text-sm text-zinc-500">
      Something not right? <a href={REPORT_BUG_PAGE} class="text-brand-600 underline hover:text-brand-700 dark:text-brand-400">Let us know</a>.
    </p>
    <a href="/" class="mt-6 inline-block rounded-lg px-4 py-2 font-medium text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white">Back home</a>
  </div>
</Layout>

<script>
  import confetti from 'canvas-confetti';

  const params = new URLSearchParams(location.search);
  const token = params.get('customer_session_token');

  // Keep the session token out of the address bar, history and anything shared from here.
  if (token) history.replaceState(null, '', location.pathname);

  celebrate();
  if (token) showLicenseKey(token);

  function celebrate() {
    const colors = ['#8250e7', '#b67dff', '#c9a3ff', '#fff7ef', '#ffb347'];
    const shared = { colors, disableForReducedMotion: true, zIndex: 50 };
    confetti({ ...shared, particleCount: 120, spread: 80, startVelocity: 45, origin: { y: 0.35 } });
    // Then a burst from each side.
    setTimeout(() => {
      confetti({ ...shared, particleCount: 60, angle: 60, spread: 60, origin: { x: 0, y: 0.6 } });
      confetti({ ...shared, particleCount: 60, angle: 120, spread: 60, origin: { x: 1, y: 0.6 } });
    }, 350);
  }

  function show(state: 'loading' | 'key' | 'fallback') {
    for (const el of document.querySelectorAll<HTMLElement>('[data-state]')) {
      el.hidden = el.dataset.state !== state;
    }
  }

  async function showLicenseKey(token: string) {
    show('loading');
    // Polar grants the license key benefit shortly after checkout, so it may not be there on the first try.
    for (let attempt = 0; attempt < 6; attempt++) {
      if (attempt > 0) await new Promise((resolve) => setTimeout(resolve, 2000));
      try {
        const response = await fetch('https://api.polar.sh/v1/customer-portal/license-keys/?limit=10', {
          headers: { Authorization: `Bearer ${token}` },
        });
        if (response.status === 401 || response.status === 403) break; // expired or invalid; retrying won't help
        if (!response.ok) continue;
        const { items } = (await response.json()) as { items: { key: string; status: string }[] };
        const key = items.find((item) => item.status === 'granted')?.key;
        if (key) return revealKey(key);
      } catch {
        // Network error: try again.
      }
    }
    show('fallback');
  }

  function revealKey(key: string) {
    document.querySelector('[data-key]')!.textContent = key;
    const button = document.querySelector<HTMLButtonElement>('[data-copy]')!;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(key);
        button.textContent = 'Copied!';
      } catch {
        // Clipboard blocked: select the key so it can be copied by hand.
        getSelection()?.selectAllChildren(document.querySelector('[data-key]')!);
        return;
      }
      setTimeout(() => (button.textContent = 'Copy'), 2000);
    });
    show('key');
  }
</script>
