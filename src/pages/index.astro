---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Kbd from '../components/Kbd.astro';
import { BUY_URL, DOWNLOAD_URL, PRICES, REPORT_BUG_PAGE } from '../consts';
import palette from '../assets/palette.png';

const steps = [
  { keys: ['⇧', '⌘', 'K'], title: 'Open the palette', body: 'From anywhere, with the hotkey, menubar icon, or services menu.' },
  { keys: ['⌘', 'V'], title: 'Drop in your text', body: 'Paste it into the Typer Util palette.' },
  { keys: ['⌘', '⏎'], title: 'Press Ready', body: 'Click into the target field while the countdown runs, then Typer Util types it for you.' },
];

const features = [
  {
    title: 'Works where paste doesn’t',
    body: 'Password confirmations, bank forms, remote desktops and VMs: anything that blocks paste or mangles pasted input gets real keystrokes instead.',
  },
  {
    title: 'Custom speed',
    body: 'Send keystrokes at any speed to work around fussy fields.',
  },
  {
    title: 'Safe with new lines and tabs',
    body: 'Return and Tab can submit forms or jump fields. You control how you send control characters.',
  },
  {
    title: 'Any keyboard layout',
    body: 'Characters that need Option on your layout can be typed with Option the way a real keyboard would.',
  },
  {
    title: 'Right from the Services menu',
    body: 'Select text in any app and choose “Type with Typer Util” from the right-click menu. Give it a shortcut if you like.',
  },
  {
    title: 'Scriptable',
    body: 'Drive it from a URL scheme, AppleScript or the bundled typerutil command-line tool.',
  },
];

const licenseTerms = [
  { title: '7-day free trial', body: 'Download it and use everything for a week before you decide.' },
  { title: 'No subscriptions', body: 'Buy it once and it\'s yours forever.' },
  { title: 'All your Macs', body: 'One license works on every Mac you use.' },
];

const scripting = [
  { label: 'Command line', code: 'pbpaste | typerutil --speed fast --ready' },
  { label: 'AppleScript', code: 'tell application "Typer Util"\n    type text "Hello world" speed "fast" countdown 5 with ready\nend tell' },
  { label: 'URL scheme', code: 'open "typerutil://type?text=Hello%20world&speed=fast&ready=1"' },
];
---

<Layout>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-40 -z-10 flex justify-center blur-3xl">
      <div class="aspect-[2/1] w-[60rem] bg-gradient-to-tr from-brand-400 to-brand-700 opacity-25 dark:opacity-30" style="clip-path: ellipse(50% 40% at 50% 50%)"></div>
    </div>

    <div class="mx-auto grid max-w-5xl items-center gap-12 px-4 pt-12 pb-20 sm:px-6 md:grid-cols-[1.1fr_1fr] md:pt-20">
      <div>
        <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-brand-500/30 bg-brand-500/10 px-3 py-1 text-xs font-medium text-brand-700 dark:text-brand-300">
          A menubar app for macOS
        </p>
        <h1 class="text-4xl font-bold tracking-tight text-balance text-zinc-900 sm:text-5xl dark:text-white">
          Simulate real typing
        </h1>
        <p class="mt-5 text-lg text-pretty text-zinc-600 dark:text-zinc-400">
          Typer Util types text into any app, one keystroke at a time, for forms that block paste or mangle
          what you paste into them (e.g. secure website forms, PDFs, virtual machines).
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href={DOWNLOAD_URL} class="inline-flex items-center gap-2 rounded-lg bg-brand-500 px-5 py-3 font-medium text-white shadow-lg shadow-brand-500/25 hover:bg-brand-600">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true"><path d="M12 15V3m0 12-4-4m4 4 4-4M2 17l.62 2.48A2 2 0 0 0 4.56 21h14.88a2 2 0 0 0 1.94-1.52L22 17"/></svg>
            Download for Mac
          </a>
          <span class="text-sm text-zinc-500">Free for 7 days · macOS 13 or later</span>
        </div>
      </div>

      <div class="flex flex-col items-center">
        <!-- Screenshot of the palette, cropped to its rounded corners on a transparent background. -->
        <Image
          src={palette}
          alt="The Typer Util palette, with a password ready to type at Normal speed after a 3-second countdown."
          widths={[491, 982]}
          sizes="(min-width: 768px) 491px, 100vw"
          loading="eager"
          class="w-full max-w-[491px] drop-shadow-2xl"
        />
        <button type="button" data-open-video class="mt-6 inline-flex items-center gap-2 rounded-full px-3 py-1.5 text-sm font-medium text-brand-600 hover:bg-brand-500/10 hover:text-brand-700 dark:text-brand-300 dark:hover:text-brand-200">
          <svg viewBox="0 0 24 24" fill="currentColor" class="size-4" aria-hidden="true"><path d="M8 5.14v13.72a1 1 0 0 0 1.52.85l11.2-6.86a1 1 0 0 0 0-1.7L9.52 4.29A1 1 0 0 0 8 5.14Z"/></svg>
          Play demo video
        </button>
      </div>
    </div>
  </section>

  <!-- Demo video overlay. The video only loads when it's opened. Clicking outside it or pressing Escape closes it. -->
  <dialog id="demo-video" aria-label="Typer Util demo video" class="m-auto w-[min(64rem,calc(100vw-2rem))] max-w-none overflow-visible bg-transparent p-0 backdrop:bg-black/80 backdrop:backdrop-blur-sm">
    <div class="relative">
      <button type="button" data-close-video aria-label="Close video" class="absolute -top-11 right-0 rounded-full p-2 text-white/80 hover:bg-white/10 hover:text-white">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="size-5" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
      <video src="/demo-video.mp4" controls playsinline preload="none" width="1534" height="1080" class="h-auto max-h-[85vh] w-full rounded-xl bg-black shadow-2xl"></video>
    </div>
  </dialog>

  <!-- How it works -->
  <section class="border-y border-zinc-200 bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-900/40">
    <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
      <h2 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-white">How it works</h2>
      <ol class="mt-8 grid gap-8 md:grid-cols-3">
        {steps.map((step, i) => (
          <li>
            <div class="flex items-center gap-3">
              <span class="flex size-7 items-center justify-center rounded-full bg-brand-500 text-sm font-semibold text-white">{i + 1}</span>
              <span class="flex gap-1">{step.keys.map((key) => <Kbd>{key}</Kbd>)}</span>
            </div>
            <h3 class="mt-4 font-semibold text-zinc-900 dark:text-white">{step.title}</h3>
            <p class="mt-1 text-zinc-600 dark:text-zinc-400">{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Features -->
  <section class="mx-auto max-w-5xl px-4 py-20 sm:px-6">
    <h2 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-white">Small and simple</h2>
    <div class="mt-8 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((feature) => (
        <div>
          <h3 class="flex items-center gap-2 font-semibold text-zinc-900 dark:text-white">
            <span class="size-1.5 rounded-full bg-brand-500"></span>
            {feature.title}
          </h3>
          <p class="mt-2 text-zinc-600 dark:text-zinc-400">{feature.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Pricing -->
  <section id="pricing" class="mx-auto max-w-5xl px-4 pb-20 sm:px-6">
    <div class="rounded-2xl border border-brand-500/30 bg-brand-500/5 p-6 sm:p-10">
      <h2 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-white">Buy it for <span data-price="{price}">{PRICES.other}</span></h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-3">
        {licenseTerms.map((term) => (
          <li>
            <h3 class="flex items-center gap-2 font-semibold text-zinc-900 dark:text-white">
              <span class="size-1.5 rounded-full bg-brand-500"></span>
              {term.title}
            </h3>
            <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">{term.body}</p>
          </li>
        ))}
      </ul>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href={BUY_URL} class="rounded-lg bg-brand-500 px-5 py-3 font-medium text-white shadow-lg shadow-brand-500/25 hover:bg-brand-600">Buy a license</a>
        <a href={DOWNLOAD_URL} class="rounded-lg px-5 py-3 font-medium text-brand-600 hover:text-brand-700 dark:text-brand-300 dark:hover:text-brand-400">Download the free trial</a>
      </div>
    </div>
  </section>

  <!-- Scripting -->
  <section class="mx-auto max-w-5xl px-4 pb-20 sm:px-6">
    <div class="rounded-2xl bg-zinc-900 p-6 text-zinc-100 sm:p-10 dark:bg-zinc-900 dark:ring-1 dark:ring-zinc-800">
      <h2 class="text-2xl font-bold tracking-tight text-white">Automate it</h2>
      <p class="mt-2 max-w-2xl text-zinc-400">
        Open the palette prefilled, or skip straight to the countdown, from scripts, shortcuts and the terminal.
        Perfect companion to Alfred, Raycast, Keyboard Maestro, or AI agents like Claude or ChatGPT.
      </p>
      <div class="mt-8 grid gap-6">
        {scripting.map((item) => (
          <div class="min-w-0">
            <div class="mb-2 text-xs font-medium tracking-wide text-brand-300 uppercase">{item.label}</div>
            <pre class="overflow-x-auto rounded-lg bg-black/40 p-4 font-mono text-[13px] leading-relaxed text-zinc-200"><code>{item.code}</code></pre>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Permissions / support -->
  <section class="mx-auto grid max-w-5xl gap-10 px-4 pb-24 sm:px-6 md:grid-cols-2">
    <div>
      <h2 class="text-lg font-semibold text-zinc-900 dark:text-white">The one permission it needs</h2>
      <p class="mt-2 text-zinc-600 dark:text-zinc-400">
        To type into other apps, Typer Util needs to be allowed in System Settings → Privacy &amp; Security →
        <strong class="font-medium text-zinc-800 dark:text-zinc-200">Device Control and Data Access</strong>{' '}
        (called Accessibility before macOS 27). It asks on first launch.
      </p>
    </div>
    <div>
      <h2 class="text-lg font-semibold text-zinc-900 dark:text-white">Found a bug?</h2>
      <p class="mt-2 text-zinc-600 dark:text-zinc-400">
        Include your macOS version and the app you were typing into.
      </p>
      <a href={REPORT_BUG_PAGE} class="mt-4 inline-flex items-center gap-1 font-medium text-brand-600 hover:text-brand-700 dark:text-brand-300 dark:hover:text-brand-400">
        Report a bug <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Layout>

<script>
  const dialog = document.getElementById('demo-video') as HTMLDialogElement;
  const video = dialog.querySelector('video')!;

  document.querySelector('[data-open-video]')!.addEventListener('click', () => {
    dialog.showModal();
    video.play().catch(() => {}); // Autoplay can be refused; the controls are there to start it.
  });
  dialog.querySelector('[data-close-video]')!.addEventListener('click', () => dialog.close());
  // A click on the backdrop lands on the dialog itself, outside its content.
  dialog.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
  dialog.addEventListener('close', () => video.pause());
</script>
