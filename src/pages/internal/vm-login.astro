---
import '../../styles/global.css';

// Backdrop for product videos: a macOS window around a Windows-style sign-in screen, the kind of VM or remote
// desktop where paste doesn't get through. Not linked from the site. The password field is real, so Typer Util
// can type into it on camera; Enter shows a short "Welcome" state, and Escape resets it.
const userName = 'Secure VM';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>VM sign-in · Typer Util</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="flex min-h-screen items-center justify-center overflow-hidden bg-black p-6 font-sans antialiased sm:p-10">
    <!-- macOS window -->
    <div class="flex aspect-[16/10] w-full max-w-5xl flex-col overflow-hidden rounded-xl bg-zinc-800 shadow-[0_30px_80px_-10px_rgba(0,0,0,0.6)] ring-1 ring-black/40">
      <div class="relative flex h-9 shrink-0 items-center border-b border-black/40 bg-zinc-700/90 px-3">
        <div class="flex gap-2">
          <span class="size-3 rounded-full bg-[#ff5f57] ring-1 ring-black/20"></span>
          <span class="size-3 rounded-full bg-[#febc2e] ring-1 ring-black/20"></span>
          <span class="size-3 rounded-full bg-[#28c840] ring-1 ring-black/20"></span>
        </div>
        <div class="absolute inset-x-0 text-center text-[13px] font-medium text-zinc-300">Virtual Machine</div>
      </div>

      <!-- Windows-style sign-in screen -->
      <div class="relative flex flex-1 flex-col items-center justify-center overflow-hidden text-white">
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_30%_20%,#3b82c4_0%,transparent_60%),radial-gradient(ellipse_at_80%_80%,#1e3a8a_0%,transparent_55%),linear-gradient(160deg,#0f2a5c,#1d4f91_50%,#0b1d42)]"></div>
        <div class="absolute inset-0 bg-black/20 backdrop-blur-2xl"></div>

        <form id="signin" class="relative flex flex-col items-center" autocomplete="off">
          <div class="flex size-28 items-center justify-center rounded-full bg-white/15 ring-1 ring-white/20 sm:size-36">
            <svg viewBox="0 0 24 24" fill="currentColor" class="size-16 text-white/80 sm:size-20" aria-hidden="true"><path d="M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm0 2c-4.42 0-8 2.24-8 5v1a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-1c0-2.76-3.58-5-8-5Z"/></svg>
          </div>
          <div class="mt-5 text-2xl font-light tracking-wide sm:text-3xl">{userName}</div>

          <!-- Fixed height, so the avatar and name don't move when Welcome replaces the field. -->
          <div class="mt-6 flex h-10 flex-col items-center">
            <div data-step="password" class="flex w-64 items-stretch sm:w-72">
              <input
                id="password"
                type="password"
                placeholder="Password"
                spellcheck="false"
                data-1p-ignore
                data-lpignore="true"
                class="min-w-0 flex-1 rounded-l-sm border-b-2 border-white/0 bg-white/90 px-3 py-2 text-[15px] text-zinc-900 placeholder:text-zinc-500 focus:border-[#4cc2ff] focus:outline-none"
              />
              <button type="submit" aria-label="Sign in" class="flex w-10 items-center justify-center rounded-r-sm bg-white/25 hover:bg-white/35">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
              </button>
            </div>

            <div data-step="welcome" class="flex h-10 items-center gap-3 text-xl font-light" hidden>
              <span class="size-5 animate-spin rounded-full border-2 border-white/30 border-t-white"></span>
              Welcome
            </div>
          </div>
        </form>

        <!-- Corner icons: language, network, accessibility, power -->
        <div class="absolute right-5 bottom-4 flex items-center gap-4 text-white/90">
          <span class="text-xs font-medium">ENG</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="size-5" aria-hidden="true"><path d="M2 8.5a15 15 0 0 1 20 0M5 12a10.5 10.5 0 0 1 14 0M8.5 15.5a5.5 5.5 0 0 1 7 0"/><circle cx="12" cy="19" r="1" fill="currentColor"/></svg>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="size-5" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="7.5" r="1" fill="currentColor"/><path d="M8 10.5h8M12 10.5v3.5m0 0-2 4m2-4 2 4"/></svg>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="size-5" aria-hidden="true"><path d="M12 3v8M7 6.3a8 8 0 1 0 10 0"/></svg>
        </div>
      </div>
    </div>

    <script>
      const form = document.getElementById('signin') as HTMLFormElement;
      const password = document.getElementById('password') as HTMLInputElement;
      const show = (step: 'password' | 'welcome') => {
        for (const el of form.querySelectorAll<HTMLElement>('[data-step]')) el.hidden = el.dataset.step !== step;
      };

      //password.focus();
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        if (password.value) show('welcome');
      });
      // Escape starts the take over.
      // document.addEventListener('keydown', (event) => {
      //   if (event.key !== 'Escape') return;
      //   password.value = '';
      //   show('password');
      //   password.focus();
      // });
    </script>
  </body>
</html>
